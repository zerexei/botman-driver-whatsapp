# ─────────────────────────────────────────────────────────────
# Zerexei BotMan Drivers — Environment Configuration
# Copy this file to .env and fill in your real credentials.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Messenger ─────────────────────────────────────────────────
# Meta App → Messenger → Access Tokens
MESSENGER_ACCESS_TOKEN=

# ── WhatsApp Cloud API ────────────────────────────────────────
# Meta App → WhatsApp → API Setup → Access Token
WHATSAPP_ACCESS_TOKEN=
# A secret string you choose and register in the Meta webhook dashboard
WHATSAPP_VERIFY_TOKEN=

# ── Viber ─────────────────────────────────────────────────────
# Viber Partner API token from https://partners.viber.com/
VIBER_ACCESS_TOKEN=
# Displayed name for your Viber bot
VIBER_SENDER_NAME=My Bot
# Public URL to your bot's avatar image (optional)
VIBER_SENDER_AVATAR=
